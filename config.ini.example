# deployment-repo-tool configuration -- EXAMPLE. Copy it before editing.
#
# The first of these that exists is used:
#   the --config argument
#   $DEPLOYMENT_REPO_CONFIG
#   $XDG_CONFIG_HOME/deployment-repo-tool/config.ini  (~/.config if unset)
#   config.ini next to the script
#
# This file is config.ini.example, so none of those find it: a fresh clone is
# inert and cannot push to anyone else's checkouts. Copy it to
# ~/.config/deployment-repo-tool/config.ini and put your own paths in there.
# A copy left next to the script as config.ini also works and is gitignored.
#
# The paths below are the author's; they will not exist on your machine.


[repos]
# key = where that deployment repo is checked out. ~ and $VARS are expanded.
fe = /dls_sw/work/R3.14.12.7/support/jjc62351/containers/accelerator-repos/fe/fe-deployment
va = /dls_sw/work/R3.14.12.7/support/jjc62351/containers/accelerator-repos/va/va-deployment
id = /dls_sw/work/R3.14.12.7/support/jjc62351/containers/accelerator-repos/id/id-deployment
common = /dls_sw/work/R3.14.12.7/support/jjc62351/containers/accelerator-repos/common/common-deployment
secondary = /dls_sw/work/R3.14.12.7/support/jjc62351/containers/accelerator-repos/secondary/secondary-deployment


[match]
# Which repo a SERVICE belongs to, so that -r is not needed. Comma separated
# globs, matched against the SERVICE argument exactly as you typed it. The
# first repo listed whose patterns match wins, so keep them specific: `sr*`
# alone cannot tell sr22c-va-ioc-01 from sr22c-pfwd.
#
# Because it is the argument that is matched, a half written glob may not
# identify anything: `fe15*` matches `fe*` and lands on fe, but `sr2*` has
# nothing of `-va-ioc-` in it yet. Write `sr2*-va-ioc-*`, or use -r va.
fe = fe*
va = sr*-va-ioc-*, va-*
common = sr*-pfwd, common-*, carepeater
id = id*
secondary = secondary-*, li-*


# Shorthand usable in place of a SERVICE, per repo: [<repo key>.aliases]

[fe.aliases]
all = fe[0-9]*
cs = fe[0-9][0-9][ijkb]-cs-ioc-0[1-9]
mo = fe[0-9][0-9][ijkb]-mo-ioc-0[1-9]
py = fe[0-9][0-9][ijkb]-py-ioc-0[1-9]

[va.aliases]
all = sr[0-2][0-9]c-va-ioc-[0-9][0-9]


[general]
# Repo to fall back on when nothing above identifies one. Left off on purpose:
# a name that matches nothing is usually a typo or a half written glob, and an
# error naming the configured repos is more use than quietly picking one.
# Uncomment if you would rather have a default.
# default = fe
